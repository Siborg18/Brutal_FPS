<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Makes sure the BRUTAL packages can always be restored from nuget.org,
       even if the machine-wide NuGet settings have no package sources. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
